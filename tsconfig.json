{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    // 測試用 node --experimental-strip-types 直接跑 .ts，import 必須帶副檔名。
    // 這個選項要求 noEmit（上面已設），Next 的 build 不受影響。
    "allowImportingTsExtensions": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // archive/ 必須排除:那裡的 route.ts 還 import 著已經搬走的 @/data，
  // 而 include 是 **/*.ts —— 不排除的話 next build 會直接失敗，
  // 而且是在伺服器上失敗（程式碼已拉到最新、服務還跑舊版，或整個起不來）。
  "exclude": ["node_modules", "archive"]
}
